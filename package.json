{
  "name": "evidence-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "check": "tsx apps/cli/src/cli.ts check",
    "demo": "tsx apps/cli/src/cli.ts check --cwd examples/checkout-service --diff-file changes.patch",
    "demo:healthy": "tsx apps/cli/src/cli.ts check --cwd examples/checkout-service --diff-file changes.patch --config evidence-gate.healthy.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "npm run lint && npm run typecheck && npm test",
    "db:generate": "prisma generate --config packages/persistence-prisma/prisma.config.ts",
    "db:migrate:init": "prisma migrate dev --config packages/persistence-prisma/prisma.config.ts --name init",
    "db:migrate:worker": "prisma migrate dev --config packages/persistence-prisma/prisma.config.ts --name worker_execution",
    "db:migrate:dev": "prisma migrate dev --config packages/persistence-prisma/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config packages/persistence-prisma/prisma.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
